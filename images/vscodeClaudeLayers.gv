digraph {
	newrank=true nodesep=0.35 rankdir=TB ranksep=0.3
	node [fontsize=10 shape=rectangle width=2.6]
	subgraph cluster_l5 {
		color=darkgreen fontcolor=darkgreen label="5  Emacs <-> VS Code Claude + AI-Activity" labeljust=l style=dashed
		{
			rank=same
			l5el [label="b:vscode:claude:aiActivity.el
root and here, the commit cycle,
the walk, /bx- menus" fillcolor=darkseagreen3 style=filled]
		}
	}
	subgraph cluster_l4 {
		color=darkgreen fontcolor=darkgreen label="4  Emacs <-> VS Code Claude" labeljust=l style=dashed
		{
			rank=same
			l4el [label="b:vscode:claude.el
atPrompt, sessions, base dirs,
sends, hooks, dispatch" fillcolor=darkseagreen3 style=filled]
			l4py [label="vscodeClaude.cs
sessions, claudePrompt (--submit),
hookToEmacs" fillcolor=lightsteelblue style=filled]
		}
	}
	subgraph cluster_l3 {
		color=darkgreen fontcolor=darkgreen label="3  Emacs <-> VS Code" labeljust=l style=dashed
		{
			rank=same
			l3el [label="b:vscode.el
init, fileOpen, partnerShow" fillcolor=darkseagreen3 style=filled]
			l3py [label="vscode.cs: vscodeEmacs_csu
partner file, bleeOpenFile,
bleeMagit" fillcolor=lightsteelblue style=filled]
		}
	}
	subgraph cluster_l2 {
		color=navy fontcolor=navy label="2  VS Code" labeljust=l style=solid
		{
			rank=same
			l2py [label="vscode.cs: vscode_csu
open, focus, diff, topology,
extensions, URI" fillcolor=lightsteelblue style=filled]
		}
	}
	subgraph cluster_l1 {
		color=navy fontcolor=navy label="1  AI-Activity executables" labeljust=l style=solid
		{
			rank=same
			l1engine [label="aiActivity.cs, aiActivityAssemble.cs
initiate, refresh, assemble" fillcolor=thistle style=filled]
			l1setting [label="gitOpener setting
(its value comes from above)" fillcolor=white fontsize=9 shape=note style=filled]
		}
	}
	subgraph cluster_l0 {
		color=navy fontcolor=navy label="0  AI-Activity templates" labeljust=l style=solid
		{
			rank=same
			l0tmpl [label="aiTemplates-workFlow, aiTemplates-DE
/bx- commands, AI-WORKFLOW.org,
skills; root and here" fillcolor=lavender style=filled]
			l0setting [label="register= / walk= arguments
(their values come from above)" fillcolor=white fontsize=9 shape=note style=filled]
		}
	}
	l5el -> l4el [style=invis]
	l4el -> l3el [style=invis]
	l3py -> l2py [style=invis]
	l2py -> l1engine [style=invis]
	l1engine -> l0tmpl [style=invis]
	l5el -> l4el
	l4el -> l4py [constraint=false]
	l4el -> l3el
	l4py -> l3py
	l3el -> l3py [constraint=false]
	l3py -> l2py
	l1engine -> l0tmpl
	l4el -> l5el [label=" supplies baseDir-function,
 event-hook handlers " color=gray35 constraint=false dir=back fontcolor=gray25 fontsize=8 style=dashed]
	legend [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="darkseagreen3">elisp (this package)</TD><TD BGCOLOR="lightsteelblue">Python (bisos.vscodeClaude)</TD><TD BGCOLOR="thistle">AI-Activity engine</TD><TD BGCOLOR="lavender">AI-Activity templates</TD></TR><TR><TD COLSPAN="4">solid = uses the layer below;  dashed = supplied by the layer above;  dashed box = optional (Emacs)</TD></TR></TABLE>> fontsize=9 shape=plaintext width=0]
	l0tmpl -> legend [style=invis]
}
